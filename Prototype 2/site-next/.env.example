# ==============================================================================
# SIROSIU PORTFOLIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# Option 1: Web3Forms (Recommended - Free, 250 submissions/mo, no backend server)
# Get your free access key at: https://web3forms.com (takes 10 seconds, sent to your email)
# VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# Option 2: Custom / Formspree / Serverless POST Endpoint
# Examples:
#   Formspree: https://formspree.io/f/xvovjklq
#   Cloudflare Worker: https://contact-api.sirosiu.workers.dev/api/contact
#   Vercel Function: /api/contact
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# If neither is set, the form operates in transparent client mode:
# validating fields, opening the visitor's mail app with pre-filled content,
# and providing a 1-click clipboard copy with no false transmission claims.
